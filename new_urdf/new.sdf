          <diffuse>1.0 0.85 0.0 1</diffuse>
          <specular>0.3 0.2 0.05 1</specular>
        </material>
      </visual>
    </link>

    <!-- ── link1 (driven arm from cam1) ── -->
    <joint name='Revolute_23' type='revolute'>
      <pose relative_to='cam1_1'>0 0.005 0 0 0 0</pose>
      <parent>cam1_1</parent>
      <child>link1_1</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-3.14159</lower>
          <upper>3.14159</upper>
        </limit>
        <dynamics>
          <damping>1.0</damping>
          <friction>0.3</friction>
        </dynamics>
      </axis>
    </joint>

    <link name='link1_1'>
      <pose relative_to='Revolute_23'>0 0 0 0 0 0</pose>
      <inertial>
        <pose>0 0.013991 -0.025 0 0 0</pose>
        <mass>0.122231</mass>
        <inertia>
          <ixx>5.5e-05</ixx>
