    </link>

    <!-- ── link2 (pen arm) ── -->
    <joint name='Revolute_18' type='revolute'>
      <pose relative_to='link1_1'>0 0 -0.05 0 0 0</pose>
      <parent>link1_1</parent>
      <child>link2_1</child>
      <axis>
        <xyz>0 -1 0</xyz>
