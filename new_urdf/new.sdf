          <diffuse>0.8 0.8 0.8 1</diffuse>
          <specular>0.2 0.2 0.2 1</specular>
        </material>
      </visual>
    </link>

    <!-- ── cam1 (joint2 — drives link1 chain, pivot 50mm along X) ── -->
    <joint name='Revolute_10' type='revolute'>
      <pose relative_to='base_link'>0.05 0.05 0 0 0 0</pose>
      <parent>base_link</parent>
      <child>cam1_1</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-3.14159</lower>
          <upper>3.14159</upper>
        </limit>
        <dynamics>
          <damping>2.0</damping>
          <friction>0.01</friction>
        </dynamics>
      </axis>
    </joint>

    <link name='cam1_1'>
      <pose relative_to='Revolute_10'>0 0 0 0 0 0</pose>
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>0.118683</mass>
        <inertia>
          <ixx>1.7e-05</ixx>
