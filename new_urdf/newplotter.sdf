            <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>
      </link>
  
      <!-- ── cam1 (stepper 2 — drives pen arm chain, pivot at 50mm X offset) ── -->
      <joint name='Revolute_10' type='revolute'>
        <pose relative_to='base_link'>0.05 0.05 0 0 0 0</pose>
        <parent>base_link</parent>
        <child>cam1_1</child>
        <axis>
          <xyz>0 1 0</xyz>
          <limit>
            <lower>-3.14159</lower>
            <upper>3.14159</upper>
          </limit>
          <dynamics>
            <damping>2.0</damping>
            <friction>0.01</friction>
