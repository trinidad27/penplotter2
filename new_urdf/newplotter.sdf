<sdf version='1.7'>
    <model name='penplotter'>
  
      <!-- ── world to base (fixed, 90° rotation to correct Fusion axis) ── -->
      <joint name='world_to_base' type='fixed'>
        <pose relative_to='__model__'>0 0 0.01 1.5708 0 0</pose>
        <parent>world</parent>
        <child>base_link</child>
      </joint>
  
      <link name='base_link'>
        <pose relative_to='world_to_base'>0 0 0 0 0 0</pose>
        <inertial>
          <pose>0.000455 0.008773 0 0 0 0</pose>
          <mass>2.712765</mass>
          <inertia>
            <ixx>0.006672</ixx>
            <ixy>-2.6e-05</ixy>
            <ixz>0</ixz>
            <iyy>0.012418</iyy>
            <iyz>0</iyz>
            <izz>0.006733</izz>
          </inertia>
        </inertial>
        <collision name='base_link_collision'>
          <pose>0 0 0 0 0 0</pose>
          <geometry>
            <mesh>
              <scale>0.001 0.001 0.001</scale>
              <uri>/home/aisha/Documents/penplotter2/old_meshes/base_link.stl</uri>
            </mesh>
          </geometry>
        </collision>
        <visual name='base_link_visual'>
          <pose>0 0 0 0 0 0</pose>
          <geometry>
            <mesh>
              <scale>0.001 0.001 0.001</scale>
              <uri>/home/aisha/Documents/penplotter2/old_meshes/base_link.stl</uri>
            </mesh>
          </geometry>
          <material>
            <ambient>0.2 0.4 0.8 1</ambient>
            <diffuse>0.2 0.4 0.8 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
  
      <!-- ── cam2 (stepper 1 — structural arm, link3 rigidly attached) ── -->
      <joint name='Revolute_9' type='revolute'>
        <pose relative_to='base_link'>0 0.01 0 0 0 0</pose>
        <parent>base_link</parent>
        <child>cam2_1</child>
        <axis>
          <xyz>0 1 0</xyz>
          <limit>
            <lower>-3.14159</lower>
            <upper>3.14159</upper>
          </limit>
          <dynamics>
            <damping>2.0</damping>
            <friction>0.01</friction>
          </dynamics>
        </axis>
      </joint>
  
      <link name='cam2_1'>
        <pose relative_to='Revolute_9'>0 0 0 0 0 0</pose>
        <inertial>
          <pose>0 0.015 -0.007599 0 0 0</pose>
          <mass>0.340885</mass>
          <inertia>
            <ixx>9.5e-05</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>0.000118</iyy>
            <iyz>0</iyz>
            <izz>7.7e-05</izz>
          </inertia>
        </inertial>
        <collision name='cam2_1_collision'>
          <pose>0 -0.01 0 0 0 0</pose>
          <geometry>
            <mesh>
              <scale>0.001 0.001 0.001</scale>
              <uri>/home/aisha/Documents/penplotter2/old_meshes/cam2_1.stl</uri>
            </mesh>
          </geometry>
        </collision>
        <visual name='cam2_1_visual'>
          <pose>0 -0.01 0 0 0 0</pose>
          <geometry>
            <mesh>
              <scale>0.001 0.001 0.001</scale>
              <uri>/home/aisha/Documents/penplotter2/old_meshes/cam2_1.stl</uri>
            </mesh>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>
      </link>
  
      <!-- ── link3 (rigidly attached to cam2) ── -->
      <joint name='Rigid_20' type='fixed'>
        <pose relative_to='cam2_1'>-0.03 0.025 0 0 0 0</pose>
        <parent>cam2_1</parent>
        <child>link3_1</child>
      </joint>
  
      <link name='link3_1'>
        <pose relative_to='Rigid_20'>0 0 0 0 0 0</pose>
        <inertial>
          <pose>0.03 -0.00980 -0.116721 0 0 0</pose>
          <mass>0.304465</mass>
          <inertia>
            <ixx>0.000944</ixx>
