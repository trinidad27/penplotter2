            <specular>0.3 0.2 0.05 1</specular>
          </material>
        </visual>
      </link>
  
      <!-- ── link1 (driven arm from cam1) ── -->
      <joint name='Revolute_23' type='revolute'>
        <pose relative_to='cam1_1'>0 0.005 0 0 0 0</pose>
        <parent>cam1_1</parent>
        <child>link1_1</child>
        <axis>
          <xyz>0 1 0</xyz>
          <limit>
            <lower>-3.14159</lower>
