      <!-- ══════════════════════════════════════════════════════
           LOOP CLOSURE JOINT
           Closes the 4-bar linkage: link3_1 (rigidly attached
           to cam2_1) connects to link2_1.
           Pose relative to link3_1 — tip of link3 arm.
      ══════════════════════════════════════════════════════ -->
      <joint name='loop_closure_link2_link3' type='revolute'>
        <pose relative_to='link3_1'>0 0 -0.205 0 0 0</pose>
        <parent>link3_1</parent>
        <child>link2_1</child>
        <axis>
          <xyz>0 1 0</xyz>
          <limit>
            <lower>-3.14159</lower>
            <upper>3.14159</upper>
          </limit>
          <dynamics>
            <damping>1.0</damping>
            <friction>0.3</friction>
          </dynamics>
        </axis>
        <physics>
          <ode>
            <implicit_spring_damper>1</implicit_spring_damper>
            <cfm_damping>1</cfm_damping>
          </ode>
        </physics>
      </joint>
  
      <static>0</static>
  
      <plugin name="pantograph_plugin" filename="/home/aisha/Documents/penplotter2/plugin/build/libpantograph_plugin.so"/>
  
