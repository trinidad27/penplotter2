<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="penplotter_world">

    <!-- ── Lighting ── -->
    <include>
      <uri>model://sun</uri>
    </include>

    <!-- ── Ground plane (acts as the "paper") ── -->
    <!-- <model name="paper">
      <static>true</static>
      <link name="paper_link">
        <visual name="paper_visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>0.5 0.5</size>
            </plane>
          </geometry>
          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
          </material>
        </visual>
        <collision name="paper_collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>0.5 0.5</size>
            </plane>
          </geometry>
        </collision>
      </link>
    </model> -->

    <!-- ── Physics: increase iterations for closed-loop stability ── -->
    <physics name="default_physics" default="0" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
      <ode>
        <solver>
          <type>quick</type>
          <iters>150</iters>          <!-- high iters = better constraint solving -->
          <sor>1.3</sor>
          <use_dynamic_moi_rescaling>true</use_dynamic_moi_rescaling>
        </solver>
        <constraints>
          <cfm>0.0</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>100</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

    <!-- ── The robot (URDF loaded via spawn script, not hardcoded here) ── -->

    <!-- ── A4 Paper ── -->
    <model name="a4_paper">
      <static>true</static>
      <pose>0 0.200 0.001 0 0 0</pose>
      <link name="paper_link">
        <collision name="paper_collision">
          <geometry>
            <box>
              <size>0.297 0.210 0.001</size>
            </box>
          </geometry>
        </collision>
        <visual name="paper_visual">
          <geometry>
            <box>
              <size>0.297 0.210 0.001</size>
            </box>
          </geometry>
          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
