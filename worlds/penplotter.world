    <model name="overhead_camera">
  <static>true</static>
  <pose>0 0 1.5 0 1.5708 0</pose>  <!-- x y z roll pitch yaw -->
  <!-- 1.5m above origin, pitch=π/2 points lens straight down -->

  <link name="camera_link">
    <sensor name="overhead_cam" type="camera">
      <camera>
        <horizontal_fov>1.047</horizontal_fov>  <!-- 60° FOV -->
        <image>
          <width>640</width>
          <height>300</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.1</near>
          <far>10</far>
        </clip>
      </camera>
      <always_on>1</always_on>
      <update_rate>30</update_rate>
      <visualize>true</visualize>

      <sensor name="overhead_cam" type="camera">
        <camera> ... </camera>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <visualize>true</visualize>
        <!-- no plugin tag -->
      </sensor>
    </sensor>
  </link>
</model>
```


    <!-- ── Physics: increase iterations for closed-loop stability ── -->
    <physics name="default_physics" default="0" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
      <ode>
        <solver>
          <type>quick</type>
          <iters>150</iters>          <!-- high iters = better constraint solving -->
          <sor>1.3</sor>
          <use_dynamic_moi_rescaling>true</use_dynamic_moi_rescaling>
        </solver>
        <constraints>
          <cfm>0.0</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>100</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

    <!-- ── The robot (URDF loaded via spawn script, not hardcoded here) ── -->

    <!-- ── A4 Paper ── -->
    <model name="a4_paper">
      <static>true</static>
      <pose>0 0.200 0.001 0 0 0</pose>
      <link name="paper_link">
        <collision name="paper_collision">
          <geometry>
            <box>
              <size>0.297 0.210 0.001</size>
            </box>
          </geometry>
        </collision>
        <visual name="paper_visual">
          <geometry>
            <box>
              <size>0.297 0.210 0.001</size>
            </box>
          </geometry>
          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
            <specular>0.5 0.5 0.5 1</specular>
            <emissive>0.3 0.3 0.3 1</emissive>  <!-- adds a slight self-glow so it looks crisp white -->
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
