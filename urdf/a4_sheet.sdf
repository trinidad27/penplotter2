<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="a4_sheet">
    <static>true</static>
    <!--
      A4 = 210 x 297 mm = 0.210 x 0.297 m
      The plotter's world_to_base joint applies Rx(+90°), meaning the
      robot draws in the world XY plane. The sheet lies flat in XY at
      a small Z offset so it sits just above the ground plane.

      Position: centred on the world origin so the plotter pivot (at 0,0)
      is near the middle of the sheet. Adjust -x -y when spawning if needed.
    -->
    <pose>0 0 0.002 0 0 0</pose>
    <link name="sheet_link">

      <!-- White paper surface -->
      <visual name="paper">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <box><size>0.210 0.297 0.002</size></box>
        </geometry>
        <material>
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>
          <specular>0.05 0.05 0.05 1</specular>
          <emissive>0.3 0.3 0.3 1</emissive>
        </material>
      </visual>

    </link>
  </model>
</sdf>
