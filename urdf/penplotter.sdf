        <dynamics>
          <damping>2.0</damping>
          <friction>0.01</friction>
        </dynamics>
      </axis>
    </joint>

    <link name='cam2_1'>
      <pose relative_to='Revolute_9'>0 0 0 0 0 0</pose>
