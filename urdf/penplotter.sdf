<sdf version='1.7'>
  <model name='penplotter'>

    <!-- ── world to base (fixed, 90° rotation to correct Fusion axis) ── -->
    <joint name='world_to_base' type='fixed'>
      <pose relative_to='__model__'>0 0 0.01 1.5708 0 0</pose>
      <parent>world</parent>
      <child>base_link</child>
    </joint>

    <link name='base_link'>
      <pose relative_to='world_to_base'>0 0 0 0 0 0</pose>
      <inertial>
        <pose>0 0.007778 0 0 0 0</pose>
        <mass>2.66344</mass>
        <inertia>
          <ixx>0.0065</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.012355</iyy>
          <iyz>0</iyz>
          <izz>0.0065</izz>
        </inertia>
      </inertial>
      <collision name='base_link_collision'>
        <pose>0 0 0 0 0 0</pose>
