    <!-- ══════════════════════════════════════════════════════
         LOOP CLOSURE JOINT
         Closes the 4-bar linkage: cam2_1 (which includes
         link3_1) → link2_1.

         Pose is relative_to cam2_1 (the parent).
         link3_1 is 175mm along its arm from the Rigid_20
         joint origin. In cam2_1's frame after the fixed
         joint merge, link3 extends in -Z, so the bearing
         is at z=-0.175 in cam2_1's local frame.
    ══════════════════════════════════════════════════════ -->
    <joint name='loop_closure_link2_link3' type='revolute'>
      <pose relative_to='cam2_1'>0 0 -0.175 0 0 0</pose>
      <parent>cam2_1</parent>
      <child>link2_1</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-3.14159</lower>
          <upper>3.14159</upper>
        </limit>
        <dynamics>
          <damping>1.0</damping>
          <friction>0.3</friction>
        </dynamics>
      </axis>
      <physics>
        <ode>
          <implicit_spring_damper>1</implicit_spring_damper>
          <cfm_damping>1</cfm_damping>
        </ode>
      </physics>
    </joint>

    <static>0</static>

