          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>
    </link>

    <!-- ── cam2 (stepper 1 — structural arm, link3 merged in) ── -->
    <joint name='Revolute_9' type='revolute'>
      <pose relative_to='base_link'>0 0.01 0 0 0 0</pose>
      <parent>base_link</parent>
      <child>cam2_1</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-3.14159</lower>
          <upper>3.14159</upper>
